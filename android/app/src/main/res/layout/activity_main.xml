<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:textColor="#E6EDF3"
        android:background="#161B22"
        android:padding="10dp"
        android:text="리시버를 찾는 중..." />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnStart" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="시작" />
            <Button android:id="@+id/btnStop" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="정지" />
            <Button android:id="@+id/btnRescan" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="다시 검색" />
            <Button android:id="@+id/btnSync" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="지금 맞추기" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnCh1" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="마우스→1" />
            <Button android:id="@+id/btnCh2" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="마우스→2" />
            <Button android:id="@+id/btnCh3" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="마우스→3" />
            <Button android:id="@+id/btnDiag" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="진단" />
            <Button android:id="@+id/btnCopy" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="로그 복사" />
            <Button android:id="@+id/btnClear" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="지우기" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox android:id="@+id/chkDry"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:text="시험 모드(전송 안 함)" />
        <CheckBox android:id="@+id/chkVerbose"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="12sp" android:text="자세히" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <CheckBox android:id="@+id/chkEdge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:text="화면 경계" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="12sp" android:text="좌:" />
        <Spinner android:id="@+id/spEdgeLeft"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textSize="12sp" android:text="우:" />
        <Spinner android:id="@+id/spEdgeRight"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0B0F14"
        android:padding="8dp">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textSize="11sp"
            android:textColor="#9FD1A0"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
